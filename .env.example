# ── Application ──────────────────────────────────────────
APP_ENV=development          # development | production
SECRET_KEY=change-me-to-a-random-32-char-string

# ── Database ─────────────────────────────────────────────
# SQLite (default MVP):
DATABASE_URL=sqlite:///./hc_mvp.db
# PostgreSQL (switch when ready):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/hc_mvp

# ── LINE LIFF / Messaging API ─────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret
LIFF_ID=your-liff-id

# ── Twilio SMS ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+886xxxxxxxxx   # 發送號碼

# ── Admin credentials ─────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# ── OTP settings ─────────────────────────────────────────
OTP_EXPIRE_MINUTES=10
OTP_DAILY_LIMIT=3
